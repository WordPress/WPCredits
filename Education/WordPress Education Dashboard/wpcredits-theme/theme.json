{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1240px"
		},
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "brand",
					"color": "#3858e9",
					"name": "WordPress blue"
				},
				{
					"slug": "brand-dark",
					"color": "#2e49d9",
					"name": "WordPress blue, pressed"
				},
				{
					"slug": "brand-tint",
					"color": "#ecf0fa",
					"name": "Pale indigo"
				},
				{
					"slug": "brand-border",
					"color": "#a3b1d4",
					"name": "Indigo rule"
				},
				{
					"slug": "ink",
					"color": "#1e1e1e",
					"name": "Ink"
				},
				{
					"slug": "ink-70",
					"color": "#4a4a4a",
					"name": "Ink, secondary"
				},
				{
					"slug": "ink-60",
					"color": "#757575",
					"name": "Muted text"
				},
				{
					"slug": "ink-50",
					"color": "#8d8d8d",
					"name": "Placeholder text"
				},
				{
					"slug": "line",
					"color": "#e6e6e6",
					"name": "Rule"
				},
				{
					"slug": "surface-band",
					"color": "#f4f4f4",
					"name": "Band"
				},
				{
					"slug": "surface-soft",
					"color": "#fcfcfc",
					"name": "Soft gray"
				},
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "White"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"fluid": false,
			"lineHeight": true,
			"writingMode": true,
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System",
					"fontFamily": "-apple-system, system-ui, \"Segoe UI\", Roboto, \"Helvetica Neue\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "12px",
					"name": "Extra small"
				},
				{
					"slug": "small",
					"size": "13px",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "16px",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "20px",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "26px",
					"name": "Extra large"
				},
				{
					"slug": "xx-large",
					"size": "34px",
					"name": "Huge"
				},
				{
					"slug": "display",
					"size": "44px",
					"name": "Display"
				}
			]
		},
		"spacing": {
			"customSpacingSize": false,
			"defaultSpacingSizes": false,
			"units": [
				"px",
				"%",
				"em",
				"rem",
				"vh",
				"vw"
			],
			"spacingSizes": [
				{
					"slug": "10",
					"size": "8px",
					"name": "1"
				},
				{
					"slug": "20",
					"size": "12px",
					"name": "2"
				},
				{
					"slug": "30",
					"size": "16px",
					"name": "3"
				},
				{
					"slug": "40",
					"size": "20px",
					"name": "4"
				},
				{
					"slug": "50",
					"size": "32px",
					"name": "5"
				},
				{
					"slug": "60",
					"size": "44px",
					"name": "6"
				},
				{
					"slug": "70",
					"size": "56px",
					"name": "7"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"custom": {
			"radius": {
				"card": "8px",
				"panel": "4px",
				"control": "2px",
				"pill": "999px"
			},
			"line": {
				"soft": "#ededed",
				"card": "#e4e4e4",
				"strong": "#dbdbdb",
				"control": "#8d8d8d"
			},
			"status": {
				"red": "#cc1818",
				"red-tint": "#fff6f5",
				"red-border": "#daa39b",
				"red-chip": "#f6e6e3",
				"amber": "#926300",
				"amber-tint": "#fff7e1",
				"amber-border": "#d0b481",
				"amber-chip": "#fde6be",
				"green": "#008030",
				"green-tint": "#ebffed",
				"green-border": "#8ac894"
			},
			"shadow": {
				"card": "0 1px 3px rgba(0, 0, 0, 0.06)",
				"float": "0 4px 14px rgba(0, 0, 0, 0.07)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|ink"
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.625"
		},
		"spacing": {
			"blockGap": "20px",
			"padding": {
				"left": "40px",
				"right": "40px"
			}
		},
		"elements": {
			"link": {
				"color": {
					"text": "var:preset|color|brand"
				},
				":hover": {
					"color": {
						"text": "var:preset|color|brand-dark"
					}
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var:preset|font-size|x-large",
					"fontWeight": "700",
					"lineHeight": "1.23",
					"letterSpacing": "-0.01em"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var:preset|font-size|large",
					"fontWeight": "600",
					"lineHeight": "1.3"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var:preset|font-size|medium",
					"fontWeight": "600",
					"lineHeight": "1.4"
				}
			},
			"button": {
				"color": {
					"background": "var:preset|color|brand",
					"text": "var:preset|color|base"
				},
				"border": {
					"radius": "2px"
				},
				"typography": {
					"fontSize": "var:preset|font-size|small",
					"fontWeight": "500",
					"lineHeight": "1.54"
				},
				"spacing": {
					"padding": {
						"top": "8px",
						"bottom": "8px",
						"left": "14px",
						"right": "14px"
					}
				},
				":hover": {
					"color": {
						"background": "var:preset|color|brand-dark",
						"text": "var:preset|color|base"
					}
				},
				":focus": {
					"color": {
						"background": "var:preset|color|brand-dark",
						"text": "var:preset|color|base"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var:preset|color|ink-60"
				},
				"typography": {
					"fontSize": "var:preset|font-size|x-small"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "15px",
					"fontWeight": "600",
					"lineHeight": "1.33"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|ink"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|ink"
							}
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var:preset|color|ink"
						},
						":hover": {
							"color": {
								"text": "var:preset|color|brand"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var:preset|font-size|xx-large",
					"fontWeight": "700"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var:preset|color|brand-border",
						"style": "solid",
						"width": "3px"
					}
				},
				"color": {
					"text": "var:preset|color|ink-70"
				},
				"spacing": {
					"padding": {
						"left": "18px"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var:preset|color|line"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var:preset|font-size|small"
				}
			},
			"core/code": {
				"color": {
					"background": "var:preset|color|surface-band"
				},
				"typography": {
					"fontFamily": "var:preset|font-family|mono",
					"fontSize": "var:preset|font-size|small"
				},
				"border": {
					"radius": "4px"
				},
				"spacing": {
					"padding": {
						"top": "14px",
						"bottom": "14px",
						"left": "16px",
						"right": "16px"
					}
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-full-width",
			"title": "Full width page",
			"postTypes": [
				"page"
			]
		},
		{
			"name": "page-documentation",
			"title": "Documentation",
			"postTypes": [
				"page"
			]
		}
	]
}
