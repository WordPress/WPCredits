 "content": {
  "rendered": "\n<div class=\"wp-block-group alignwide wpc-hub-hero wpc-faq-head is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-columns wpc-hub-hero__cols wpc-hub-stack is-layout-flex wp-container-core-columns-is-layout-6a600f0c wp-block-columns-is-layout-flex\" style=\"padding-top:0;padding-right:0;padding-bottom:52px;padding-left:0\">\n<div class=\"wp-block-column wpc-hub-hero__copy is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:47%\">\n<p class=\"is-style-eyebrow wp-block-paragraph\">For students</p>\n\n\n\n<h1 class=\"wp-block-heading wpc-faq-title\">Frequently asked questions</h1>\n\n\n\n<p class=\"wpc-hub-lede wp-block-paragraph\">Answers to the questions students ask most about WordPress Credits and the Education Directory. Whether or not you are in a program yet, the first thing to do is to get connected with the WordPress community.</p>\n\n\n\n<nav class=\"wp-block-group wpc-faq-nav is-layout-flow wp-block-group-is-layout-flow\" aria-label=\"On this page\">\n<p class=\"wpc-faq-nav__label wp-block-paragraph\">On this page:</p>\n\n\n\n<ul class=\"wp-block-list wpc-faq-jump\">\n<li><a href=\"#get-connected\">Get connected first</a></li>\n\n<li><a href=\"#before-you-apply\">Before you apply</a></li>\n\n<li><a href=\"#school-not-in-program\">Your school is not in the program yet?</a></li>\n\n<li><a href=\"#registering\">Registering</a></li>\n\n<li><a href=\"#tracks-mentors-hours\">Tracks, mentors and hours</a></li>\n\n<li><a href=\"#reports-credit-certificate\">Reports, credit and your certificate</a></li>\n\n<li><a href=\"#tutors-and-schools\">For tutors and schools</a></li>\n\n<li><a href=\"#something-wrong\">When something goes wrong</a></li>\n\n<li><a href=\"#still-have-a-question\">Still have a question?</a></li>\n</ul>\n</nav>\n</div>\n\n\n\n<div class=\"wp-block-column wpc-hub-hero__art is-layout-flow wp-block-column-is-layout-flow\" style=\"flex-basis:49%\">\n<div class=\"wpc-hub-art\" aria-hidden=\"true\"><svg