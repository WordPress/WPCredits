tialed // Attendee // Builder // Contributor // Graduate // Specialist</text><text x=\"-36\" y=\"216\">Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee</text><text x=\"-59\" y=\"228\">Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate</text><text x=\"-18\" y=\"240\">Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed</text><text x=\"-41\" y=\"252\">Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor</text><text x=\"-64\" y=\"264\">Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader</text><text x=\"-23\" y=\"276\">Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder</text><text x=\"-46\" y=\"288\">Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist</text><text x=\"-69\" y=\"300\">Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee</text><text x=\"-28\" y=\"312\">Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate</text><text x=\"-51\" y=\"324\">Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed</text><text x=\"-74\" y=\"336\">Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor</text><text x=\"-33\" y=\"348\">Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader</text><text x=\"-56\" y=\"360\">Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder</text><text x=\"-15\" y=\"372\">Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist</text><text x=\"-38\" y=\"384\">Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee</text><text x=\"-61\" y=\"396\">Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate // Specialist // Community Leader // Credentialed // Attendee // Builder // Contributor // Graduate</text></g><mask id=\"wpc-hub-faq-bubble\" maskUnits=\"userSpaceOnUse\" x=\"-10\" y=\"-104\" width=\"540\" height=\"494\"><path d=\"M136 30 H384 Q450 30 450 96 V234 Q450 300 384 300 H232 L124 356 L164 300 H136 Q70 300 70 234 V96 Q70 30 136 30 Z\" fill=\"#fff\"/><path d=\"M204 134 C204 100 230 80 262 80 C296 80 320 104 320 132 C320 158 298 168 282 178 C269 186 262 190 262 190\" fill=\"none\" stroke=\"#000\" stroke-width=\"88\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"262\" cy=\"262\" r=\"40\" fill=\"#000\"/></mask><mask id=\"wpc-hub-faq-mark\" maskUnits=\"userSpaceOnUse\" x=\"-10\" y=\"-104\" width=\"540\" height=\"494\"><path d=\"M204 134 C204 100 230 80 262 80 C296 80 320 104 320 132 C320 158 298 168 282 178 C269 186 262 190 262 190\" fill=\"none\" stroke=\"#fff\" stroke-width=\"56\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"262\" cy=\"262\" r=\"24\" fill=\"#fff\"/></mask><mask id=\"wpc-hub-faq-edge\" maskUnits=\"userSpaceOnUse\" x=\"-10\" y=\"-104\" width=\"540\" height=\"494\"><path d=\"M204 134 C204 100 230 80 262 80 C296 80 320 104 320 132 C320 158 298 168 282 178 C269 186 262 190 262 190\" fill=\"none\" stroke=\"#fff\" stroke-width=\"64\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"262\" cy=\"262\" r=\"28\" fill=\"#fff\"/><path d=\"M204 134 C204 100 230 80 262 80 C296 80 320 104 320 132 C320 158 298 168 282 178 C269 186 262 190 262 190\" fill=\"none\" stroke=\"#000\" stroke-width=\"59\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"262\" cy=\"262\" r=\"25.5\" fill=\"#000\"/></mask></defs><use href=\"#wpc-hub-faq-words\" class=\"wpc-hub-art__mountain-body\" mask=\"url(#wpc-hub-faq-bubble)\"/><use href=\"#wpc-hub-faq-words\" class=\"wpc-hub-art__mountain-cap\" mask=\"url(#wpc-hub-faq-mark)\"/><rect class=\"wpc-hub-art__pennant\" x=\"-10\" y=\"-104\" width=\"540\" height=\"494\" mask=\"url(#wpc-hub-faq-edge)\"/><g class=\"wpc-hub-art__tag wpc-hub-art__tag--faq\"><rect x=\"286\" y=\"330\" width=\"174\" height=\"26\" rx=\"2\"/><text x=\"296\" y=\"347.5\">Questions and answers</text></g></svg></div>\n\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-connect is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"get-connected\">Get connected first</h2>\n\n\n\n<p class=\"wpc-hub-lede wp-block-paragraph\">Do these two steps first, before you join any program. Your WordPress.org profile is where your work as a contributor is recorded, and you need the account to join the Slack.</p>\n</div>\n\n\n\n<div class=\"wp-block-columns wpc-hub-stack wpc-faq-steps is-layout-flex wp-container-core-columns-is-layout-0e47273b wp-block-columns-is-layout-flex\">\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-card wpc-faq-step is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"is-style-eyebrow wp-block-paragraph\">Step 1</p>\n\n\n\n<h3 class=\"wp-block-heading\">Create your WordPress.org account</h3>\n\n\n\n<ol class=\"wp-block-list wpc-faq-step__list\">\n<li>Open the <a href=\"https://login.wordpress.org/register\">registration page on WordPress.org</a>.</li>\n\n<li>Under <strong>Username</strong>, choose a name. Only lowercase letters (a-z) and numbers (0-9) are allowed.</li>\n\n<li>Under <strong>Email</strong>, give an address you check. A link to set your password will be sent there.</li>\n\n<li>Tick <strong>I have read and accept the Privacy Policy</strong>. Leave the other boxes as they are, then press <strong>Create Account</strong>.</li>\n\n<li>Open the email from WordPress.org and click its link to set your password and your account details.</li>\n\n<li>Complete your profile on profiles.wordpress.org, with a photo or avatar. A profile photo needs a Gravatar account.</li>\n</ol>\n\n\n\n<div class=\"wp-block-buttons wpc-faq-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button wpc-button--large\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://login.wordpress.org/register\">Create your account</a></div>\n</div>\n</div>\n</div>\n\n<div class=\"wp-block-column is-layout-flow wp-block-column-is-layout-flow\">\n<div class=\"wp-block-group is-style-card wpc-faq-step is-layout-flow wp-block-group-is-layout-flow\">\n<p class=\"is-style-eyebrow wp-block-paragraph\">Step 2</p>\n\n\n\n<h3 class=\"wp-block-heading\">Join the Making WordPress Slack</h3>\n\n\n\n<ol class=\"wp-block-list wpc-faq-step__list\">\n<li>Sign in to WordPress.org with your account. The Slack page says: &#8220;Please log in to WordPress.org first to join.&#8221;</li>\n\n<li>Go to <a href=\"https://make.wordpress.org/chat/\">chat.wordpress.org</a> and scroll to <strong>Joining the WordPress team on Slack</strong>.</li>\n\n<li>Click <strong>I understand. Let&#8217;s get started.</strong> You are taken to the Slack sign-in page.</li>\n\n<li>For the email, enter your username followed by @chat.example.test (if your username is example123, that is <code>example123​@chat.example.test</code>). Slack fills in the @chat.example.test part.</li>\n\n<li>Open the confirmation email from Slack. It is forwarded to your WordPress.org account&#8217;s address. Click <strong>Confirm email</strong>.</li>\n\n<li>Add your name and choose a password for Slack. From then on, sign in at wordpress.slack.com or in the Slack apps.</li>\n</ol>\n\n\n\n<div class=\"wp-block-buttons wpc-faq-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button is-style-outline wpc-button--large is-style-outline--1\"><a class=\"wp-block-button__link wp-element-button\" href=\"https://make.wordpress.org/chat/\">Open the Slack page</a></div>\n</div>\n</div>\n</div>\n</div>\n\n\n\n<p class=\"wpc-faq-hello wp-block-paragraph\"><strong>Then say hello in <a href=\"https://wordpress.slack.com/archives/C0959D2M3T8\">#wpcredits</a>.</strong> In Slack, click <strong>Browse all channels</strong>, type wpcredits and join the channel. It is where students and the program team talk, and you can ask questions about the program there. Please follow the <a href=\"https://make.wordpress.org/handbook/community-code-of-conduct/\">WordPress community code of conduct</a>.</p>\n\n\n\n<div class=\"wp-block-group wpc-faq-group wpc-faq-stuck is-layout-flow wp-block-group-is-layout-flow\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h3 class=\"wp-block-heading wpc-hub-anchored\" id=\"stuck-on-a-step\">Stuck on a step?</h3>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"account-email-not-arrived\"><summary>The email from WordPress.org did not arrive</summary>\n<p class=\"wp-block-paragraph\">Check every folder, spam and junk too. If it still has not come, or you are blocked from signing up, write to the program's address.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"account-already-have\"><summary>I already have a WordPress.org account</summary>\n<p class=\"wp-block-paragraph\">Use it. You only need one WordPress.org account to contribute to any team, and you can go straight to step 6, your profile.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"account-username\"><summary>Which username should I choose?</summary>\n<p class=\"wp-block-paragraph\">Your real name or a professional nickname, in lowercase letters and numbers. Your username is part of your public profile&#8217;s address, so choose one you are happy to share.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"slack-email-not-arrived\"><summary>The confirmation email from Slack did not arrive</summary>\n<p class=\"wp-block-paragraph\">It goes to the address on your WordPress.org account, so look there, in spam and junk too. If it still has not come, write to the program's address.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"slack-which-email\"><summary>Slack asks for an email. Which one do I use?</summary>\n<p class=\"wp-block-paragraph\">Your username followed by @chat.example.test: if your username is example123, that is example123​@chat.example.test. This is also how you sign in to Slack later. Only Slack can email this address, and it forwards to your WordPress.org account&#8217;s address.</p>\n</details>\n</div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"before-you-apply\">Before you apply</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"what-is-wordpress-credits\"><summary>What is WordPress Credits?</summary>\n<p class=\"wp-block-paragraph\">An education program of the WordPress Foundation. Students contribute to the WordPress open source project with a mentor&#8217;s guidance, and their school can recognize the work for academic credit. It is fully online.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"who-can-join\"><summary>Who can join? My school is not in the program.</summary>\n<p class=\"wp-block-paragraph\">Students of schools in the program join through their school. If yours is not in the program yet, tell us about it with the <a href=\"#school-not-in-program\">student interest form</a> or ask a faculty member or your administration office to <a href=\"/institution-application/\">apply</a>. You do not have to wait to <a href=\"#get-connected\">get connected</a>: create your WordPress.org account and join the Slack today.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"do-i-need-to-code\"><summary>Do I need to know how to code?</summary>\n<p class=\"wp-block-paragraph\">No. Most ways to contribute need no code: design, writing, testing, translating, organizing and promoting are all contributions. Developers have a track of their own.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"english\"><summary>How good does my English need to be?</summary>\n<p class=\"wp-block-paragraph\">The course is in English. It asks for written communication and independent remote work. The registration form also asks which languages you speak.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"does-it-cost\"><summary>Does it cost anything?</summary>\n<p class=\"wp-block-paragraph\">No. The program is free for students and for schools.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"what-do-i-get\"><summary>What do I get out of it?</summary>\n<p class=\"wp-block-paragraph\">Hands-on open source experience, a public record of your contributions on your WordPress.org profile, a mentor&#8217;s guidance, and a WordPress Credits certificate when you complete the program.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group wpc-faq-interest is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"school-not-in-program\">Your school is not in the program yet?</h2>\n</div>\n\n\n\n<p class=\"wp-block-paragraph\">Tell us about it with the student interest form. It asks for your name and email, your school, and a representative at your school, with their email, who knows about your request and has agreed to be contacted.</p>\n\n\n\n<p class=\"wp-block-paragraph\">The program team reads every interest and writes to that representative, and you get an email that your interest was received. Your school can also apply itself with the <a href=\"/institution-application/\">institution application</a>.</p>\n\n\n\n<div class=\"wp-block-buttons wpc-faq-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button wpc-button--large\"><a class=\"wp-block-button__link wp-element-button\" href=\"/students/#wpcpm-student-interest\">Tell us about your school</a></div>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"registering\">Registering</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"account-before-registering\"><summary>Do I need a WordPress.org account before I register?</summary>\n<p class=\"wp-block-paragraph\">Create it first: it is the first step for every student. <a href=\"#get-connected\">Get connected first</a> says why and how. If you already have one, use it.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"where-to-register\"><summary>Where do I register?</summary>\n<p class=\"wp-block-paragraph\">Your school tells you how. When registration is open, Register as a student is under Get involved at the top of every page. Some schools enroll their students themselves.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"what-the-form-asks\"><summary>What does the registration form ask for?</summary>\n<p class=\"wp-block-paragraph\">Your name and email, your school and department, your track when your school offers more than one, your tutor if your school has one, your dates and expected hours, the languages you speak, and any accessibility needs. You also confirm that the course is in English and remote, and accept the privacy policy.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"after-registering\"><summary>I registered. What happens next?</summary>\n<p class=\"wp-block-paragraph\">You get an email that your registration was received. Once you are enrolled, two more emails follow: a welcome email with your course link, and an invitation to set your password on the Education Directory.</p>\n\n<p class=\"wp-block-paragraph\">Both go to the address you gave, so check your spam folder. If nothing arrives, tell the program team.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"which-email\"><summary>Which email address should I use?</summary>\n<p class=\"wp-block-paragraph\">One you read every day. Every program email, your sign-in and your password resets go to it. To change it later, ask the program team.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"tracks-mentors-hours\">Tracks, mentors and hours</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"which-track\"><summary>Which track should I choose?</summary>\n<p class=\"wp-block-paragraph\">Your school decides which tracks it offers. If it offers more than one, the form asks which you want, and &#8220;Not sure yet&#8221; is an answer. The program team then assigns your track.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"mentor\"><summary>Will I have a mentor?</summary>\n<p class=\"wp-block-paragraph\">The program pairs an enrolled student with a mentor, an experienced WordPress contributor. Your mentor&#8217;s name is in your welcome email and on your Student Report Card, and you book calls with your mentor from your Student Report Card.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"hours-and-dates\"><summary>How many hours is it, and when can I start?</summary>\n<p class=\"wp-block-paragraph\">Each track sets its own hours. Your school agrees the hours and your dates with you, and some tracks have no hours target. Start and end dates follow your school&#8217;s calendar; there are no fixed global dates.</p>\n\n<p class=\"wp-block-paragraph\">There is no timesheet: you keep a running total on your Student Report Card and press Save hours.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"contribution-project\"><summary>What counts as a contribution project?</summary>\n<p class=\"wp-block-paragraph\">Work that supports an existing WordPress team and leaves something useful behind, chosen with your mentor. A personal blog or portfolio does not count.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"own-website\"><summary>Do I need my own website?</summary>\n<p class=\"wp-block-paragraph\">It depends on your track. Most full tracks ask for reflection posts on a personal website; on the introduction tracks a site is optional and you write one final project report instead. Your report form shows what yours asks for.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"when-to-work\"><summary>Do I have to work at fixed times?</summary>\n<p class=\"wp-block-paragraph\">No. You choose when to work and there is no fixed weekly schedule. Team meetings have set times, so pick the ones that fit, take part when you go, and stay consistent.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"reports-credit-certificate\">Reports, credit and your certificate</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"student-report-card\"><summary>What is the Student Report Card, and how do I get in?</summary>\n<p class=\"wp-block-paragraph\">Your page on the Education Directory, with your mentor, your course, your hours and your report form. You do not sign up for it: the program team creates your account and emails you an invitation.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"report-form\"><summary>What do I fill in on the report form?</summary>\n<p class=\"wp-block-paragraph\">Onboarding (your WordPress.org profile, your Slack name, your module grades), your project (your team, what you contributed, the meetings you joined) and the wrap-up. Fill it in a little at a time and press Save my report.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"academic-credit\"><summary>Who gives the academic credit?</summary>\n<p class=\"wp-block-paragraph\">Your school does. The program records your work and confirms it to your school. Whether and how it counts toward your degree, or as a required internship, is your school&#8217;s decision, so ask your tutor.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"how-to-finish\"><summary>How do I finish, and do I get a certificate?</summary>\n<p class=\"wp-block-paragraph\">Complete your track&#8217;s wrap-up, your last feedback form and the course&#8217;s final lesson. Your status shows &#8220;Pending graduation&#8221; until the program team records your graduation, and you receive a WordPress Credits certificate.</p>\n\n<p class=\"wp-block-paragraph\">You keep your Student Report Card after you graduate, and your WordPress.org profile keeps recording what you contribute.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"tutors-and-schools\">For tutors and schools</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"students-onboarded\"><summary>How do we know our students have been onboarded?</summary>\n<p class=\"wp-block-paragraph\">Each enrolled student is sent the two emails in <a href=\"#after-registering\">I registered. What happens next?</a>, to the address the student gave, so ask them to check spam. Once your school&#8217;s Collaboration Agreement is accepted, your Institution Dashboard lists your students. If a student has received nothing, tell the program team.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"school-enrolls-students\"><summary>Can our school enroll its students itself?</summary>\n<p class=\"wp-block-paragraph\">Once your school&#8217;s Collaboration Agreement is accepted and the program has switched enrollment on, a representative can enroll students from your Institution Dashboard. Otherwise, students register through the site&#8217;s form: Register as a student, under Get involved, while registration is open.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"school-sees-progress\"><summary>Can a tutor see a student&#8217;s progress?</summary>\n<p class=\"wp-block-paragraph\">Yes, on the school&#8217;s private Institution Dashboard. A representative of the school invites the tutor with Invite a colleague and chooses the Tutor level.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"teachers-mentor\"><summary>Can our teachers mentor our students?</summary>\n<p class=\"wp-block-paragraph\">Yes. Faculty can train as mentors and mentor their own students. Start on the <a href=\"/mentors/\">Mentors page</a>.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"something-wrong\">When something goes wrong</h2>\n</div>\n\n\n\n<div class=\"wp-block-group wpc-faq__list is-layout-flow wp-block-group-is-layout-flow\">\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"welcome-email-not-arrived\"><summary>I did not get the welcome email or the invitation</summary>\n<p class=\"wp-block-paragraph\">Check your spam folder. The sign-in email comes from the program's address. If nothing has come a day after your school or the program told you that you are enrolled, write to the program's address or ask in <a href=\"https://wordpress.slack.com/archives/C0959D2M3T8\">#wpcredits</a>; the invitation can be sent again.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"cannot-sign-in\"><summary>The invitation link expired, or I cannot sign in</summary>\n<p class=\"wp-block-paragraph\">On the site&#8217;s login page, use &#8220;Lost your password?&#8221; with the address on your account. The newest email&#8217;s link replaces older ones. If the site asks for a code, it comes by email.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"page-empty\"><summary>I signed in, but my page is empty or says I have no access</summary>\n<p class=\"wp-block-paragraph\">Your account exists but is not linked to your program record yet. Write to the program team at the program's address.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"details-wrong\"><summary>Something on my Student Report Card is wrong</summary>\n<p class=\"wp-block-paragraph\">Your dates, school and tutor come from the program&#8217;s records: ask your mentor or the program team. Your WordPress.org profile, Slack name, team and website are yours to correct in your report form.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"mentor-not-responding\"><summary>I cannot reach my mentor</summary>\n<p class=\"wp-block-paragraph\">Ask in <a href=\"https://wordpress.slack.com/archives/C0959D2M3T8\">#wpcredits</a> or write to the program team at the program's address.</p>\n</details>\n\n\n\n<details class=\"wp-block-details is-layout-flow wp-block-details-is-layout-flow\" id=\"pause-or-stop\"><summary>I have to pause or stop</summary>\n<p class=\"wp-block-paragraph\">Tell your mentor and the program team as early as you can. Your school decides what it means for your credit.</p>\n</details>\n</div>\n</div>\n\n\n\n<div class=\"wp-block-group alignwide wpc-section wpc-faq-group wpc-faq-still is-layout-flow wp-block-group-is-layout-flow\" style=\"padding-top:48px;padding-bottom:48px\">\n<div class=\"wp-block-group wpc-hub-head is-layout-flow wp-block-group-is-layout-flow\">\n<h2 class=\"wp-block-heading wpc-hub-anchored\" id=\"still-have-a-question\">Still have a question?</h2>\n</div>\n\n\n\n<p class=\"wp-block-paragraph\">Ask your mentor first, if you have one. You can also ask in <a href=\"https://wordpress.slack.com/archives/C0959D2M3T8\">#wpcredits</a> on the Making WordPress Slack, or write to the program team at the program's address.</p>\n\n\n\n<div class=\"wp-block-buttons wpc-faq-buttons is-layout-flex wp-block-buttons-is-layout-flex\">\n<div class=\"wp-block-button wpc-button--large\"><a class=\"wp-block-button__link wp-element-button\" href=\"/students/\">Go to the Students page</a></div>\n</div>\n</div>\n\n",
  "protected": false
 }
}