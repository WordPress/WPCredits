#!/usr/bin/env bash
# Build the installable zip from .distignore.
#
#   bash bin/build            writes ../<slug>.zip (the file WordPress installs)
#   bash bin/build out.zip    writes somewhere else, for a dry run or a diff
#
# Every non-comment line of .distignore is excluded, at the root and anywhere
# below it. The archive holds a single top-level <slug>/ folder, which is what
# the WordPress uploader requires, and the version printed at the end is read
# back from inside the archive, not from the working tree. Anything that goes
# wrong is said on stderr with a non-zero status: bin/test-tooling.php holds
# the check.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
slug="$(basename "$root")"
parent="$(dirname "$root")"

# The slug is the folder's name when the folder holds the plugin file of that name. A tree in a
# folder of another name, a linked worktree under .worktrees/ named after its branch or a clone made
# under any name, takes the slug from the plugin's own header instead: the Text Domain of the file
# that carries the Plugin Name, which is named after the slug. The zip is then made through a link of
# that name to the tree, so its one folder is still the slug WordPress installs it under.
stage=""
if [ ! -f "$root/$slug.php" ]; then
	main="$(grep -l -E '^[[:space:]]*\*?[[:space:]]*Plugin Name:' "$root"/*.php 2>/dev/null | head -n 1 || true)"
	named=""
	if [ -n "$main" ]; then
		named="$(sed -n -E 's/^[[:space:]]*\*?[[:space:]]*Text Domain:[[:space:]]*([^[:space:]]+).*/\1/p' "$main" | head -n 1 || true)"
	fi
	if [ -n "$named" ]; then
		slug="$named"
		stage="$(mktemp -d "${TMPDIR:-/tmp}/wpcpm-build.XXXXXX")"
		trap 'rm -rf "$stage"' EXIT
		ln -s "$root" "$stage/$slug"
		parent="$stage"
	fi
fi

out="${1:-$(dirname "$root")/$slug.zip}"
case "$out" in /*) ;; *) out="$PWD/$out" ;; esac

excludes=()
while IFS= read -r line || [ -n "$line" ]; do
	line="${line%%#*}"
	line="$(printf '%s' "$line" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
	[ -z "$line" ] && continue
	case "$line" in
		*/*) excludes+=( "$slug/$line" "$slug/$line/*" ) ;;
		*)   excludes+=( "$slug/$line" "$slug/$line/*" "$slug/*/$line" "$slug/*/$line/*" ) ;;
	esac
done < "$root/.distignore"

cd "$parent"
find "$root" -name .DS_Store -delete
rm -f "$out"

# Every failure below has to reach the person who ran the build. `set -e` ends the script on
# any of them, but it ends it in silence: a zip that could not be written, and a version line
# that could not be read, both looked exactly like a successful build that printed nothing
# (deep check finding FSUIT-10, where the grep below matched nothing because the plugin
# directory had been cloned under another name).
zip -rqX "$out" "$slug" -x "${excludes[@]}" || {
	status=$?
	echo "ERROR: zip exited $status; no archive was written to $out" >&2
	exit 1
}

# The archive is read back once, and the read is allowed to fail so that the message below is
# reachable: this assignment, the entry count and the size were each their own pipeline under
# `set -euo pipefail`, which is the same shape as the version line and the same silence
# (FSUIT-10). One read also means the list and its count can never disagree.
entries="$(unzip -Z1 "$out" || true)"

if [ -z "$entries" ]; then
	echo "ERROR: could not read $out back; it lists no entries" >&2
	exit 1
fi

tops="$(printf '%s\n' "$entries" | cut -d/ -f1 | sort -u | tr '\n' ' ')"
count="$(printf '%s\n' "$entries" | wc -l | tr -d ' ')"
size="$(du -h "$out" | cut -f1 || true)"

# `|| true` so a grep that matches nothing is a blank version rather than the end of the
# script, and the message below is reachable. This is what a build looks like when the slug was
# found in neither place above: a folder not named after the plugin, whose plugin header names no
# Text Domain, or none the plugin file is named after.
version="$(unzip -p "$out" "$slug/$slug.php" 2>/dev/null | grep -m1 -E '^ \* Version:' | sed 's/.*Version:[[:space:]]*//' || true)"

if [ -z "$version" ]; then
	echo "ERROR: no Version line in $slug/$slug.php inside $out - is this directory named after the plugin slug, or does the plugin header name it as its Text Domain?" >&2
	exit 1
fi

printf 'built %s\n  top-level: %s\n  version inside: %s\n  entries: %s, size: %s\n' \
	"$out" "$tops" "$version" "$count" "$size"
[ "$tops" = "$slug " ] || { echo "ERROR: more than one top-level folder" >&2; exit 1; }
