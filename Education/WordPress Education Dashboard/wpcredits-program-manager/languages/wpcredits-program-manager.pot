msgstr ""

#: includes/class-wpcpm-admin.php:1056
msgid "Check mentors with status"
msgstr ""

#: includes/class-wpcpm-admin.php:1056
msgid "Only mentors holding this status are looked up."
msgstr ""

#: includes/class-wpcpm-admin.php:1057
msgid "Promote them to"
msgstr ""

#: includes/class-wpcpm-admin.php:1057
msgid ""
"Writing this status needs the <code>data.records:write</code> scope on the "
