{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcpm/student-dashboard",
	"version": "1.12.0",
	"title": "My Program (Student)",
	"category": "widgets",
	"icon": "welcome-learn-more",
