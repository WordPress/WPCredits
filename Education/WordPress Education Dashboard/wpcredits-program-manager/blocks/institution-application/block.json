{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcpm/institution-application",
	"version": "1.72.1",
	"title": "Institution Application Form",
	"category": "widgets",
	"icon": "welcome-write-blog",
