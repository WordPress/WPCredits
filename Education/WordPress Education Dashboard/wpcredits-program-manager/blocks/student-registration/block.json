{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcpm/student-registration",
	"version": "1.123.54",
	"title": "Student Registration Form",
	"category": "widgets",
	"icon": "welcome-learn-more",
	"description": "The public form a student fills in to register for the WordPress Credits Program.",
	"keywords": [ "student", "registration", "register", "wpcredits" ],
	"textdomain": "wpcredits-program-manager",
	"attributes": {
		"title": {
			"type": "string",
			"default": ""
		},
		"thanks": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"multiple": false,
		"align": [ "wide", "full" ]
	},
	"editorScript": "file:./editor.js"
}
